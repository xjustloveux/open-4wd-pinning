{"nodes": [{"id": "config_config_example_pinning_service_configuration", "label": "Pinning Service Example Configuration", "file_type": "document", "source_file": "config/config.example.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "config_config_example_configuration_precedence", "label": "Configuration Precedence", "file_type": "rationale", "rationale": "Environment variables override YAML values, which override built-in defaults; invalid non-positive numeric values fall through to the next layer while DMCA_ENABLE is enabled only by the exact string true.", "source_file": "config/config.example.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "config_config_example_cors_allowlist", "label": "Fail-Closed CORS Allowlist", "file_type": "rationale", "rationale": "Browser origins must be explicitly listed as complete origins; wildcards and URL components beyond origin are rejected, and an empty list denies cross-origin browser access while preserving same-origin and server-to-server calls.", "source_file": "config/config.example.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "config_config_example_service_data_directory", "label": "Replica Service Data Directory", "file_type": "rationale", "rationale": "The normal replica data directory contains blockstore, datastore, OrbitDB, and DMCA notice subdirectories and must not be shared with the one-shot genesis data directory.", "source_file": "config/config.example.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "config_config_example_ledger_db_address", "label": "Ledger OrbitDB Address", "file_type": "concept", "rationale": "The address is mandatory, must match the deployment value and /orbitdb/<CIDv1-base58btc> format, and comes from the one-shot public genesis receipt rather than a database-name fallback.", "source_file": "config/config.example.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "config_config_example_genesis_timestamp", "label": "Ledger Genesis Timestamp", "file_type": "concept", "rationale": "The mandatory UTC millisecond timestamp must be copied from the one-shot public receipt and cannot be replaced by local service startup time.", "source_file": "config/config.example.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "config_config_example_governance_signers", "label": "Governance Signer Trust Root", "file_type": "rationale", "rationale": "The signer set authorizes checkpoint adoption and automated pinning; an empty set fails closed by disabling local proposals and rejecting remote announcements while leaving authorized pin APIs usable.", "source_file": "config/config.example.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "config_config_example_libp2p_connectivity", "label": "Libp2p Connectivity Configuration", "file_type": "concept", "source_file": "config/config.example.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "config_config_example_pin_authorization", "label": "Pin Authorization Policy", "file_type": "rationale", "rationale": "API pin authorization is the union of an explicit signer allowlist and a reputation threshold; if both are absent all API pin requests are denied while automated pinning remains independent.", "source_file": "config/config.example.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "config_config_example_quota_model", "label": "Unique-Block Quota Model", "file_type": "rationale", "rationale": "Automated system content consumes only global quota, while global usage is reconstructed from unique block bytes referenced by Cluster roots rather than summed root metadata.", "source_file": "config/config.example.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "config_config_example_storage_headroom_invariant", "label": "Storage Headroom Invariant", "file_type": "rationale", "rationale": "Application quota, Kubo StorageMax, and volume capacity must be adjusted together with space reserved for Kubo metadata, temporary data, and garbage collection.", "source_file": "config/config.example.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "config_config_example_dual_rate_limiting", "label": "Per-IP and Per-Signer Rate Limiting", "file_type": "rationale", "rationale": "Signer limits apply after signature validation alongside per-IP token buckets so clients cannot evade throttling merely by changing IP addresses.", "source_file": "config/config.example.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "config_config_example_provider_ugc_capabilities", "label": "Provider UGC Capabilities", "file_type": "concept", "rationale": "Read, write, and transparency capabilities are independently advertised; disabling writes closes /pin but deliberately leaves /unpin available, and the DMCA module remains separate.", "source_file": "config/config.example.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "config_config_example_provider_policy_urls", "label": "Provider Policy URLs", "file_type": "rationale", "rationale": "Optional public UGC, legal, privacy, and retention policy links accept only HTTPS URLs without credentials, query strings, or fragments.", "source_file": "config/config.example.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "config_config_example_private_metrics_listener", "label": "Private Prometheus Listener", "file_type": "rationale", "rationale": "Metrics are disabled by default and must be scraped by an operator's private Prometheus rather than sharing the public management API ingress.", "source_file": "config/config.example.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "config_config_example_dmca_module", "label": "Single-Instance DMCA Notice Module", "file_type": "rationale", "rationale": "The DMCA module is disabled by default, may run on only one instance, and fails startup when enabled without an administrative token.", "source_file": "config/config.example.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "config_config_example_cloudflare_access_identity", "label": "Cloudflare Access Operator Identity", "file_type": "rationale", "rationale": "Cloudflare-injected email is trusted as operator identity only when the origin exclusively accepts Tunnel and Access traffic.", "source_file": "config/config.example.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "config_config_example_configuration_precedence", "target": "config_config_example_pinning_service_configuration", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "config/config.example.yaml", "source_location": null, "weight": 1.0}, {"source": "config_config_example_cors_allowlist", "target": "config_config_example_pinning_service_configuration", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "config/config.example.yaml", "source_location": null, "weight": 1.0}, {"source": "config_config_example_service_data_directory", "ta