{
  "name": "open-4wd-pinning",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "type": "module",
  "scripts": {
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "check:comments": "tsx scripts/comment-quality.ts",
    "check:comments:self-test": "tsx scripts/comment-quality.self-test.ts",
    "comments:hook:staged": "node scripts/comment-hook-runner.mjs staged",
    "comments:hook:full": "node scripts/comment-hook-runner.mjs full",
    "comments:hooks:setup": "node scripts/setup-comment-hooks.mjs setup",
    "comments:hooks:disable": "node scripts/setup-comment-hooks.mjs disable",
    "check:vendor": "tsx scripts/check-vendor.ts",
    "check:vendor:local": "tsx scripts/check-vendor.ts --local-only",
    "vendor:sync": "tsx scripts/vendor-sync.ts",
    "ledger:genesis": "tsx scripts/ledger-genesis.ts",
    "ledger:rebirth-proof": "tsx scripts/initial-checkpoint-proof-bundle.ts",
    "test:scripts": "node --test scripts/comment-hook-runner.test.mjs scripts/eslint-comment-quality.test.mjs scripts/issue-maintenance.test.mjs scripts/prepare-graphify-release.test.mjs scripts/run-graphify-release.test.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "start": "tsx app/main.ts",
    "dmca:export": "tsx scripts/dmca-export.ts"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@helia/bitswap": "4.0.7",
    "@helia/libp2p": "1.0.7",
    "@ipld/dag-cbor": "10.0.1",
    "@ipld/dag-pb": "4.1.7",
    "@libp2p/bootstrap": "12.0.28",
    "@libp2p/circuit-relay-v2": "4.2.10",
    "@libp2p/crypto": "5.1.21",
    "@libp2p/gossipsub": "16.1.0",
    "@libp2p/identify": "4.1.11",
    "@libp2p/kad-dht": "16.4.1",
    "@libp2p/peer-id": "6.0.13",
    "@libp2p/ping": "3.1.10",
    "@libp2p/webrtc": "6.0.28",
    "@libp2p/websockets": "10.1.18",
    "@multiformats/multiaddr": "13.0.3",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@orbitdb/core": "4.0.0",
    "@scure/base": "2.2.0",
    "@scure/bip39": "2.2.0",
    "blockstore-fs": "4.0.1",
    "blockstore-idb": "4.0.1",
    "classic-level": "3.0.0",
    "datastore-idb": "5.0.1",
    "datastore-level": "13.0.1",
    "helia": "7.1.2",
    "libp2p": "3.3.7",
    "multiformats": "14.0.5",
    "nodemailer": "9.0.3",
    "swagger-ui-dist": "5.32.11",
    "tsx": "4.23.1",
    "ulid": "3.0.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@libp2p/memory": "2.0.25",
    "@types/node": "26.1.2",
    "@types/nodemailer": "8.0.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
